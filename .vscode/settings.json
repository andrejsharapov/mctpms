{
	"cSpell.words": [
		"blockbench",
		"blockstates",
		"mcmeta",
		"mctpms"
	],
	"editor.formatOnSave": true,
	"editor.insertSpaces": true,
	"editor.stickyTabStops": true,
	"editor.tabSize": 2,
	"[json]": {
		"editor.defaultFormatter": "vscode.json-language-features"
	},
	"fracturedjsonvsc.MaxTotalLineLength": 150,
	"fracturedjsonvsc.MaxInlineComplexity": 2,
	"fracturedjsonvsc.MaxCompactArrayComplexity": 1,
	"fracturedjsonvsc.MaxTableRowComplexity": 1,
	"fracturedjsonvsc.MinCompactArrayRowItems": 3,
	"fracturedjsonvsc.NestedBracketPadding": false,
	"fracturedjsonvsc.SimpleBracketPadding": false,
	"fracturedjsonvsc.ColonPadding": false,
	"fracturedjsonvsc.CommaPadding": false,
	"fracturedjsonvsc.PreserveBlankLines": false
}